{
  "name": "mingzhang-sdd-dsh",
  "version": "0.4.0",
  "description": "Load the frozen mingzhang-sdd skill through the DSH plugin manager.",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.mjs",
    "cordis.patch.yml",
    "SKILL.md",
    "rules/",
    "skills/",
    "references/",
    "scripts/",
    "assets/templates/",
    "README.md"
  ],
  "engines": { "node": ">=24" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } }
}
